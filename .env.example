# docker compose için yerel ayarlar. Bu dosyayı .env adıyla kopyalayın; .env Git'e eklenmez.

# Docker içindeki PostgreSQL hesabı (ilk açılışta bu bilgilerle oluşturulur).
DB_USERNAME=cargo
DB_PASSWORD=replace-with-a-local-database-password

# openssl rand -base64 32 çıktısı
JWT_SECRET=replace-with-a-random-base64-key-at-least-32-bytes

# İlk yönetici: ilk açılışta oluşturulur. Hesap zaten varsa şifresi, rolü veya aktifliği
# değiştirilmez; bu yüzden ayarı açık bırakmak güvenlidir. Şifre en az 12 karakter, en fazla 72 bayt.
DEV_ADMIN_ENABLED=true
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace-with-a-12-char-or-longer-password

# İsteğe bağlı
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Şifre sıfırlama e-postasındaki bağlantının açılacağı frontend sayfası
# PASSWORD_RESET_URL=http://localhost:3000/reset-password
# DB_HOST_PORT=5433
